@implements IDisposable
@inject SessionState SessionState

<nav class="sidebar-nav">
    <div class="brand-block">
        <a class="brand" href="/">Mundial 2026</a>
        <span class="brand-subtitle">Panel de administración</span>
    </div>

    <div class="menu-section">
        <span class="menu-title">General</span>
        <NavLink href="/" Match="NavLinkMatch.All">Dashboard</NavLink>
        <NavLink href="/consultas">Consultas</NavLink>
        <NavLink href="/reportes">Reportes</NavLink>
    </div>

    @if (SessionState.CanEditData)
    {
        <div class="menu-section">
            <span class="menu-title">Catálogos</span>
            <NavLink href="/confederaciones">Confederaciones</NavLink>
            <NavLink href="/paises">Países</NavLink>
            <NavLink href="/ciudades">Ciudades</NavLink>
            <NavLink href="/estadios">Estadios</NavLink>
            <NavLink href="/grupos">Grupos</NavLink>
        </div>

        <div class="menu-section">
            <span class="menu-title">Competencia</span>
            <NavLink href="/equipos">Equipos</NavLink>
            <NavLink href="/directores-tecnicos">Directores técnicos</NavLink>
            <NavLink href="/jugadores">Jugadores</NavLink>
            <NavLink href="/partidos">Partidos</NavLink>
        </div>
    }

    @if (SessionState.CanManageUsers)
    {
        <div class="menu-section">
            <span class="menu-title">Seguridad</span>
            <NavLink href="/usuarios">Usuarios</NavLink>
        </div>
    }
</nav>

@code {
    protected override void OnInitialized()
    {
        SessionState.Changed += OnSessionChanged;
    }

    private void OnSessionChanged() => InvokeAsync(StateHasChanged);

    public void Dispose()
    {
        SessionState.Changed -= OnSessionChanged;
    }
}
