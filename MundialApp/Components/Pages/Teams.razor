@page "/equipos"
@inject TeamService TeamService
@inject LookupService LookupService
@inject SessionState SessionState
@inject ImageStorageService ImageStorageService

<PageTitle>Equipos</PageTitle>

@if (!SessionState.CanEditData)
{
    <AccessDenied />
}
else
{
    <SectionHeader Title="Gestión de equipos" Subtitle="CRUD de equipos participantes.">
        <button @onclick="OpenNewModal">Nuevo equipo</button>
    </SectionHeader>

    <section class="panel panel-table panel-table--full">
        <table>
            <thead>
                <tr>
                    <th>Escudo</th>
                    <th>Nombre</th>
                    <th>Grupo</th>
                    <th>País</th>
                    <th>Confederación</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in items)
                {
                    <tr>
                        <td>
                            @if (!string.IsNullOrWhiteSpace(item.Escudo))
                            {
                                <img class="table-image" src="@item.Escudo" alt="Escudo de @item.Nombre" />
                            }
                            else
                            {
                                <span class="table-image table-image--placeholder">Sin imagen</span>
                            }
                        </td>
                        <td>@item.Nombre</td>
                        <td>@item.Grupo</td>
                        <td>@item.Pais</td>
                        <td>@item.Confederacion</td>
                        <td class="actions-cell">
                            <button class="secondary" @onclick="() => Edit(item)">Editar</button>
                            <button class="danger" @onclick="() => DeleteAsync(item.IdEquipo)">Eliminar</button>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </section>

    <AppModal IsOpen="isModalOpen" Title="@modalTitle" Subtitle="Registre o actualice la información del equipo." OnClose="CloseModal">
        <EditForm Model="currentItem" OnValidSubmit="SaveAsync">
            <div class="form-grid two-columns">
                <div><label>Nombre</label><InputText @bind-Value="currentItem.Nombre" /></div>
                <div>
                    <label>País</label>
                    <InputSelect @bind-Value="currentItem.IdPais" @bind-Value:after="SyncTeamNameFromCountry">
                        @foreach (var item in paises)
                        {
                            <option value="@item.Id">@item.Nombre</option>
                        }
                    </InputSelect>
                </div>
                <div>
                    <label>Grupo</label>
                    <InputSelect @bind-Value="currentItem.IdGrupo">
                        @foreach (var item in grupos)
                        {
                            <option value="@item.Id">@item.Nombre</option>
                        }
                    </InputSelect>
                </div>
                <div>
                    <label>Confederación</label>
                    <InputSelect @bind-Value="currentItem.IdConfederacion">
                        @foreach (var item in confederaciones)
                        {
                            <option value="@item.Id">@item.Nombre</option>
                        }
                    </InputSelect>
                </div>
                <div class="full-width">
                    <label>Escudo</label>
                    <InputFile OnChange="OnShieldSelectedAsync" accept="image/*" />
                </div>
                @if (!string.IsNullOrWhiteSpace(currentItem.Escudo))
                {
                    <div class="full-width image-preview-card">
                        <img class="image-preview" src="@currentItem.Escudo" alt="Vista previa del escudo" />
                    </div>
                }
            </div>
            <div class="actions-row">
                <button type="submit">Guardar</button>
                <button type="button" class="secondary" @onclick="CloseModal">Cancelar</button>
            </div>
        </EditForm>
    </AppModal>
}

@code {
    private List<Models.Entities.Equipo> items = new();
    private Models.Entities.Equipo currentItem = new();
    private List<Models.Entities.LookupItem> grupos = new();
    private List<Models.Entities.LookupItem> paises = new();
    private List<Models.Entities.LookupItem> confederaciones = new();
    private bool isModalOpen;
    private string modalTitle = "Nuevo equipo";

    protected override async Task OnInitializedAsync()
    {
        grupos = await LookupService.GetGruposAsync();
        paises = await LookupService.GetPaisesAsync();
        confederaciones = await LookupService.GetConfederacionesAsync();
        await LoadAsync();
        SetDefaults();
    }

    private async Task LoadAsync() => items = await TeamService.GetAllAsync();

    private async Task SaveAsync()
    {
        await TeamService.SaveAsync(currentItem);
        await LoadAsync();
        CloseModal();
    }

    private void Edit(Models.Entities.Equipo item)
    {
        currentItem = new Models.Entities.Equipo
        {
            IdEquipo = item.IdEquipo,
            Nombre = item.Nombre,
            Escudo = item.Escudo,
            IdGrupo = item.IdGrupo,
            IdPais = item.IdPais,
            IdConfederacion = item.IdConfederacion
        };

        modalTitle = "Editar equipo";
        isModalOpen = true;
    }

    private async Task DeleteAsync(int id)
    {
        await TeamService.DeleteAsync(id);
        await LoadAsync();
        if (currentItem.IdEquipo == id)
        {
            NewItem();
        }
    }

    private void NewItem()
    {
        currentItem = new Models.Entities.Equipo();
        SetDefaults();
    }

    private void OpenNewModal()
    {
        NewItem();
        modalTitle = "Nuevo equipo";
        isModalOpen = true;
    }

    private void CloseModal()
    {
        isModalOpen = false;
        NewItem();
    }

    private Task SyncTeamNameFromCountry()
    {
        var selectedCountry = paises.FirstOrDefault(x => x.Id == currentItem.IdPais);
        if (selectedCountry is not null)
        {
            currentItem.Nombre = selectedCountry.Nombre;
        }

        return Task.CompletedTask;
    }

    private async Task OnShieldSelectedAsync(InputFileChangeEventArgs args)
    {
        var file = args.File;
        if (file is null)
        {
            return;
        }

        currentItem.Escudo = await ImageStorageService.SaveImageAsync(file, "escudos");
    }

    private void SetDefaults()
    {
        currentItem.IdGrupo = grupos.FirstOrDefault()?.Id ?? 0;
        currentItem.IdPais = paises.FirstOrDefault()?.Id ?? 0;
        currentItem.IdConfederacion = confederaciones.FirstOrDefault()?.Id ?? 0;
    }
}
