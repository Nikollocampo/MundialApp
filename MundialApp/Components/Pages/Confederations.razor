@page "/confederaciones"
@inject ConfederationService Service
@inject SessionState SessionState

<PageTitle>Confederaciones</PageTitle>

@if (!SessionState.CanEditData)
{
    <AccessDenied />
}
else
{
    <SectionHeader Title="Confederaciones" Subtitle="CRUD de confederaciones del mundial.">
        <button @onclick="OpenNewModal">Nueva confederación</button>
    </SectionHeader>

    <section class="panel panel-table panel-table--full">
        <table>
            <thead><tr><th>Nombre</th><th>Cupos</th><th>Fecha</th><th></th></tr></thead>
            <tbody>
                @foreach (var item in items)
                {
                    <tr>
                        <td>@item.Nombre</td>
                        <td>@item.CuposMundial</td>
                        <td>@item.FechaCreacion?.ToString("dd/MM/yyyy")</td>
                        <td class="actions-cell">
                            <button class="secondary" @onclick="() => Edit(item)">Editar</button>
                            <button class="danger" @onclick="() => DeleteAsync(item.IdConfederacion)">Eliminar</button>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </section>

    <AppModal IsOpen="isModalOpen" Title="@modalTitle" Subtitle="Registre o actualice la confederación." OnClose="CloseModal">
        <EditForm Model="currentItem" OnValidSubmit="SaveAsync">
            <div class="form-grid two-columns">
                <div class="full-width"><label>Nombre</label><InputText @bind-Value="currentItem.Nombre" /></div>
                <div><label>Cupos</label><InputNumber @bind-Value="currentItem.CuposMundial" /></div>
                <div><label>Fecha creación</label><InputDate @bind-Value="fechaCreacion" /></div>
            </div>
            <div class="actions-row">
                <button type="submit">Guardar</button>
                <button type="button" class="secondary" @onclick="CloseModal">Cancelar</button>
            </div>
        </EditForm>
    </AppModal>
}

@code {
    private List<Confederacion> items = new();
    private Confederacion currentItem = new() { FechaCreacion = DateTime.Today };
    private DateTime fechaCreacion = DateTime.Today;
    private bool isModalOpen;
    private string modalTitle = "Nueva confederación";

    protected override async Task OnInitializedAsync() => await LoadAsync();

    private async Task LoadAsync() => items = await Service.GetAllAsync();

    private async Task SaveAsync()
    {
        currentItem.FechaCreacion = fechaCreacion;
        await Service.SaveAsync(currentItem);
        await LoadAsync();
        CloseModal();
    }

    private void Edit(Confederacion item)
    {
        currentItem = new Confederacion
        {
            IdConfederacion = item.IdConfederacion,
            Nombre = item.Nombre,
            CuposMundial = item.CuposMundial,
            FechaCreacion = item.FechaCreacion
        };
        fechaCreacion = item.FechaCreacion ?? DateTime.Today;
        modalTitle = "Editar confederación";
        isModalOpen = true;
    }

    private async Task DeleteAsync(int id)
    {
        await Service.DeleteAsync(id);
        await LoadAsync();
        if (currentItem.IdConfederacion == id) NewItem();
    }

    private void NewItem()
    {
        currentItem = new Confederacion { FechaCreacion = DateTime.Today };
        fechaCreacion = DateTime.Today;
    }

    private void OpenNewModal()
    {
        NewItem();
        modalTitle = "Nueva confederación";
        isModalOpen = true;
    }

    private void CloseModal()
    {
        isModalOpen = false;
        NewItem();
    }
}
