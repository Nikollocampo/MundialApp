@page "/grupos"
@inject GroupService Service
@inject SessionState SessionState

<PageTitle>Grupos</PageTitle>

@if (!SessionState.CanEditData)
{
    <AccessDenied />
}
else
{
    <SectionHeader Title="Grupos" Subtitle="CRUD de grupos del torneo.">
        <button @onclick="OpenNewModal">Nuevo grupo</button>
    </SectionHeader>

    <section class="panel panel-table panel-table--full">
        <table>
            <thead><tr><th>Grupo</th><th></th></tr></thead>
            <tbody>
                @foreach (var item in items)
                {
                    <tr>
                        <td>@item.Nombre</td>
                        <td class="actions-cell">
                            <button class="secondary" @onclick="() => Edit(item)">Editar</button>
                            <button class="danger" @onclick="() => DeleteAsync(item.IdGrupo)">Eliminar</button>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </section>

    <AppModal IsOpen="isModalOpen" Title="@modalTitle" Subtitle="Registre o actualice el grupo." OnClose="CloseModal">
        <EditForm Model="currentItem" OnValidSubmit="SaveAsync">
            <div class="form-grid single-column">
                <div><label>Nombre</label><InputText @bind-Value="currentItem.Nombre" /></div>
            </div>
            <div class="actions-row">
                <button type="submit">Guardar</button>
                <button type="button" class="secondary" @onclick="CloseModal">Cancelar</button>
            </div>
        </EditForm>
    </AppModal>
}

@code {
    private List<Grupo> items = new();
    private Grupo currentItem = new();
    private bool isModalOpen;
    private string modalTitle = "Nuevo grupo";

    protected override async Task OnInitializedAsync() => await LoadAsync();
    private async Task LoadAsync() => items = await Service.GetAllAsync();

    private async Task SaveAsync()
    {
        await Service.SaveAsync(currentItem);
        await LoadAsync();
        CloseModal();
    }

    private void Edit(Grupo item)
    {
        currentItem = new Grupo { IdGrupo = item.IdGrupo, Nombre = item.Nombre };
        modalTitle = "Editar grupo";
        isModalOpen = true;
    }

    private async Task DeleteAsync(int id)
    {
        await Service.DeleteAsync(id);
        await LoadAsync();
        if (currentItem.IdGrupo == id) NewItem();
    }

    private void NewItem() => currentItem = new Grupo();

    private void OpenNewModal()
    {
        NewItem();
        modalTitle = "Nuevo grupo";
        isModalOpen = true;
    }

    private void CloseModal()
    {
        isModalOpen = false;
        NewItem();
    }
}
