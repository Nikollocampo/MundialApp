@page "/paises"
@inject CountryService Service
@inject SessionState SessionState

<PageTitle>Países</PageTitle>

@if (!SessionState.CanEditData)
{
    <AccessDenied />
}
else
{
    <SectionHeader Title="Países" Subtitle="CRUD de países participantes y anfitriones.">
        <button @onclick="OpenNewModal">Nuevo país</button>
    </SectionHeader>

    <section class="panel panel-table panel-table--full">
        <table>
            <thead><tr><th>Nombre</th><th>MSNM</th><th>Anfitrión</th><th></th></tr></thead>
            <tbody>
                @foreach (var item in items)
                {
                    <tr>
                        <td>@item.Nombre</td>
                        <td>@item.Msnm</td>
                        <td>@(item.EsAnfitrion ? "Sí" : "No")</td>
                        <td class="actions-cell">
                            <button class="secondary" @onclick="() => Edit(item)">Editar</button>
                            <button class="danger" @onclick="() => DeleteAsync(item.IdPais)">Eliminar</button>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </section>

    <AppModal IsOpen="isModalOpen" Title="@modalTitle" Subtitle="Registre o actualice el país." OnClose="CloseModal">
        <EditForm Model="currentItem" OnValidSubmit="SaveAsync">
            <div class="form-grid two-columns">
                <div class="full-width"><label>Nombre</label><InputText @bind-Value="currentItem.Nombre" /></div>
                <div><label>MSNM</label><InputNumber @bind-Value="currentItem.Msnm" /></div>
                <div class="checkbox-field">
                    <label><InputCheckbox @bind-Value="currentItem.EsAnfitrion" /> Es anfitrión</label>
                </div>
            </div>
            <div class="actions-row">
                <button type="submit">Guardar</button>
                <button type="button" class="secondary" @onclick="CloseModal">Cancelar</button>
            </div>
        </EditForm>
    </AppModal>
}

@code {
    private List<Pais> items = new();
    private Pais currentItem = new();
    private bool isModalOpen;
    private string modalTitle = "Nuevo país";

    protected override async Task OnInitializedAsync() => await LoadAsync();
    private async Task LoadAsync() => items = await Service.GetAllAsync();

    private async Task SaveAsync()
    {
        await Service.SaveAsync(currentItem);
        await LoadAsync();
        CloseModal();
    }

    private void Edit(Pais item)
    {
        currentItem = new Pais
        {
            IdPais = item.IdPais,
            Nombre = item.Nombre,
            Msnm = item.Msnm,
            EsAnfitrion = item.EsAnfitrion
        };

        modalTitle = "Editar país";
        isModalOpen = true;
    }

    private async Task DeleteAsync(int id)
    {
        await Service.DeleteAsync(id);
        await LoadAsync();
        if (currentItem.IdPais == id) NewItem();
    }

    private void NewItem() => currentItem = new Pais();

    private void OpenNewModal()
    {
        NewItem();
        modalTitle = "Nuevo país";
        isModalOpen = true;
    }

    private void CloseModal()
    {
        isModalOpen = false;
        NewItem();
    }
}
