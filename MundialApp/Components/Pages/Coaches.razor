@page "/directores-tecnicos"
@inject CoachService Service
@inject LookupService LookupService
@inject SessionState SessionState

<PageTitle>Directores Técnicos</PageTitle>

@if (!SessionState.CanEditData)
{
    <AccessDenied />
}
else
{
    <SectionHeader Title="Directores técnicos" Subtitle="CRUD de directores técnicos por equipo.">
        <button @onclick="OpenNewModal">Nuevo director técnico</button>
    </SectionHeader>

    <section class="panel panel-table panel-table--full">
        <table>
            <thead><tr><th>Nombre</th><th>Nacionalidad</th><th>Equipo</th><th></th></tr></thead>
            <tbody>
                @foreach (var item in items)
                {
                    <tr>
                        <td>@item.Nombre</td>
                        <td>@item.Nacionalidad</td>
                        <td>@item.Equipo</td>
                        <td class="actions-cell">
                            <button class="secondary" @onclick="() => Edit(item)">Editar</button>
                            <button class="danger" @onclick="() => DeleteAsync(item.IdDt)">Eliminar</button>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </section>

    <AppModal IsOpen="isModalOpen" Title="@modalTitle" Subtitle="Registre o actualice el director técnico." OnClose="CloseModal">
        <EditForm Model="currentItem" OnValidSubmit="SaveAsync">
            <div class="form-grid two-columns">
                <div class="full-width"><label>Nombre</label><InputText @bind-Value="currentItem.Nombre" /></div>
                <div><label>Nacionalidad</label><InputText @bind-Value="currentItem.Nacionalidad" /></div>
                <div>
                    <label>Equipo</label>
                    <InputSelect @bind-Value="currentItem.IdEquipo">
                        <option value="0">Seleccione...</option>
                        @foreach (var item in equipos)
                        {
                            <option value="@item.Id">@item.Nombre</option>
                        }
                    </InputSelect>
                </div>
            </div>
            <div class="actions-row">
                <button type="submit">Guardar</button>
                <button type="button" class="secondary" @onclick="CloseModal">Cancelar</button>
            </div>

            @if (!string.IsNullOrWhiteSpace(errorMessage))
            {
                <p class="status-message error">@errorMessage</p>
            }
        </EditForm>
    </AppModal>
}

@code {
    private List<DirectorTecnico> items = new();
    private List<LookupItem> equipos = new();
    private DirectorTecnico currentItem = new();
    private bool isModalOpen;
    private string modalTitle = "Nuevo director técnico";
    private string? errorMessage;

    protected override async Task OnInitializedAsync()
    {
        equipos = await LookupService.GetEquiposAsync();
        await LoadAsync();
        SetDefaults();
    }

    private async Task LoadAsync() => items = await Service.GetAllAsync();

    private async Task SaveAsync()
    {
        if (currentItem.IdEquipo == 0)
        {
            errorMessage = "Debe seleccionar un equipo.";
            return;
        }

        try
        {
            errorMessage = null;
            await Service.SaveAsync(currentItem);
            await LoadAsync();
            CloseModal();
        }
        catch (Exception ex)
        {
            errorMessage = ex.GetBaseException().Message;
        }
    }

    private void Edit(DirectorTecnico item)
    {
        currentItem = new DirectorTecnico
        {
            IdDt = item.IdDt,
            Nombre = item.Nombre,
            Nacionalidad = item.Nacionalidad,
            IdEquipo = item.IdEquipo
        };

        modalTitle = "Editar director técnico";
        isModalOpen = true;
    }

    private async Task DeleteAsync(int id)
    {
        await Service.DeleteAsync(id);
        await LoadAsync();
        if (currentItem.IdDt == id) NewItem();
    }

    private void NewItem()
    {
        currentItem = new DirectorTecnico();
        errorMessage = null;
        SetDefaults();
    }

    private void OpenNewModal()
    {
        NewItem();
        modalTitle = "Nuevo director técnico";
        isModalOpen = true;
    }

    private void CloseModal()
    {
        isModalOpen = false;
        NewItem();
    }

    private void SetDefaults() => currentItem.IdEquipo = 0;
}
