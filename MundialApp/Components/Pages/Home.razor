@page "/"
@implements IDisposable
@inject DashboardService DashboardService
@inject SessionState SessionState
@inject AuthService AuthService
@inject NavigationManager NavigationManager

<PageTitle>Dashboard</PageTitle>

@if (!SessionState.IsAuthenticated)
{
    <Login />
}
else
{
    @if (summary is null)
    {
        <p>Cargando información...</p>
    }
    else
    {
        <section class="dashboard-hero panel">
            <div>
                <span class="dashboard-hero__eyebrow">Panel principal</span>
                <h1>Dashboard</h1>
                <p>Resumen general del mundial 2026 con accesos rápidos e información relevante del torneo.</p>
            </div>
            <div class="dashboard-hero__meta">
                <div class="dashboard-hero__user">
                    <span>Usuario actual</span>
                    <strong>@SessionState.CurrentUser?.Nombre</strong>
                    <small>@SessionState.CurrentUser?.Rol</small>
                </div>
                <button class="secondary" @onclick="LogoutAsync">Cerrar sesión</button>
            </div>
        </section>

        <section class="dashboard-grid dashboard-grid--compact">
            <DashboardCard Title="Equipos" Value="@summary.TotalEquipos.ToString()" />
            <DashboardCard Title="Jugadores" Value="@summary.TotalJugadores.ToString()" />
            <DashboardCard Title="Partidos" Value="@summary.TotalPartidos.ToString()" />
            <DashboardCard Title="Estadios" Value="@summary.TotalEstadios.ToString()" />
            <DashboardCard Title="Usuarios" Value="@summary.TotalUsuarios.ToString()" />
        </section>

        <div class="dashboard-main-grid">
            <section class="panel">
                <h3>Países anfitriones</h3>
                <ul class="host-list">
                    @foreach (var host in summary.PaisesAnfitriones)
                    {
                        <li>@host</li>
                    }
                </ul>
            </section>

            <section class="panel dashboard-role-panel">
                <h3>Rol actual</h3>
                <p class="dashboard-role-panel__value">@SessionState.CurrentUser!.Rol</p>
            </section>

            <section class="panel dashboard-table-panel">
                <h3>Próximos partidos</h3>
                <table>
                    <thead>
                        <tr>
                            <th>Fecha</th>
                            <th>Partido</th>
                            <th>Estadio</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var partido in summary.ProximosPartidos)
                        {
                            <tr>
                                <td>@partido.Fecha.ToString("dd/MM/yyyy HH:mm")</td>
                                <td>@partido.EquipoLocal vs @partido.EquipoVisitante</td>
                                <td>@partido.Estadio - @partido.Ciudad</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </section>
        </div>
    }
}

@code {
    private Models.Dto.DashboardSummary? summary;

    protected override async Task OnInitializedAsync()
    {
        SessionState.Changed += OnSessionChanged;

        if (SessionState.IsAuthenticated)
        {
            summary = await DashboardService.GetSummaryAsync();
        }
    }

    private async void OnSessionChanged()
    {
        if (SessionState.IsAuthenticated)
        {
            summary = await DashboardService.GetSummaryAsync();
        }
        else
        {
            summary = null;
        }

        await InvokeAsync(StateHasChanged);
    }

    private async Task LogoutAsync()
    {
        await AuthService.LogoutAsync();
        NavigationManager.NavigateTo("/");
    }

    public void Dispose()
    {
        SessionState.Changed -= OnSessionChanged;
    }
}
